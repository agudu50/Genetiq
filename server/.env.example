# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Server Configuration
PORT=3000
NODE_ENV=development

# Client origin for CORS (set to your deployed frontend URL in production)
CLIENT_URL=http://localhost:3000

# Google AI Studio / Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMMA_MODEL=models/gemma-4-26b-a4b-it

# Google Cloud Platform (GCP) Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=genetiq-medical-records

# Hugging Face (required for local/gated models)
HF_TOKEN=your-hf-read-token-here

# Hugging Face S3-compatible storage (optional — prefixed; not used by hub loader)
HF_S3_ACCESS_KEY_ID=your-hf-s3-access-key
HF_S3_SECRET_ACCESS_KEY=your-hf-s3-secret-key
HF_S3_ENDPOINT=https://s3.hf.co/your-username

